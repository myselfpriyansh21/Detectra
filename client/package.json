    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
